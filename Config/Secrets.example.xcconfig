// Copy to Secrets.xcconfig (gitignored) and fill in. Used from M3 on.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY = your-publishable-key

// Strava API app (M4): the client ID only, it isn't secret. The client secret goes into
// `supabase secrets set STRAVA_CLIENT_SECRET=…`, never here.
STRAVA_CLIENT_ID = your-strava-client-id
